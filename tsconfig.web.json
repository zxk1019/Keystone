{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.tsx",
    "src/preload/*.d.ts",
    "src/shared/**/*",
    "src/core/**/*"
  ],
  // The tests of shared/ and core/ run on Node.js: tsconfig.node.json checks them
  "exclude": ["src/shared/**/*.test.ts", "src/core/**/*.test.ts"],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "paths": {
      "@renderer/*": ["./src/renderer/src/*"],
      "@shared/*": ["./src/shared/*"],
      "@core/*": ["./src/core/*"],
      "@platform": ["./src/renderer/src/platform/desktop.ts"]
    }
  }
}
